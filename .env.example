# Supabase project credentials — Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of this app, used to build auth email redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anthropic API key for the AI assistant. Server-only — never exposed to the
# browser. Get one from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI API key for Instagram visual generation (gpt-image-1). Server-only —
# never exposed to the browser. Get one from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# fal.ai API key — server-only image/video generation provider. Never
# exposed to the browser. Get one from https://fal.ai/dashboard/keys
FAL_KEY=

# Optional, server-only, development/benchmarking use only: names a key in
# media/config.ts's IMAGE_MODEL_CONFIGS allowlist (e.g. "fal-benchmark") to
# override the default OpenAI image provider/model for /api/generate-visual.
# Leave unset to use the production default (OpenAI + gpt-image-1).
IMAGE_MODEL_BENCHMARK_OVERRIDE=

# Instagram API with Instagram Login ("Instagram Business Login") app
# credentials — used only by src/app/api/meta/connect and
# src/app/api/meta/callback to start/complete the OAuth flow for connecting
# an Instagram professional publishing account. Server-only, never exposed
# to the browser.
#
# IMPORTANT: these are the INSTAGRAM-specific App ID/Secret, found at
# https://developers.facebook.com/apps under your app's
# Instagram > API setup with Instagram login > Business login settings —
# NOT the top-level Meta/Facebook App ID/Secret shown on the app's main
# Settings > Basic page; those are different values and will be rejected.
# Leave unset to keep the connection disabled (both routes return an
# explicit 501 rather than a broken/fake flow).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
